# Durable Growth OS worker — deploy on Railway / Render, not Vercel Functions.
# Connect only to the matching environment database (staging ≠ production).
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
# Keep tsx/prisma CLI available for the durable worker process image.
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate
COPY scripts ./scripts
COPY src ./src
COPY tsconfig.json ./
CMD ["npx", "tsx", "scripts/worker.ts"]
