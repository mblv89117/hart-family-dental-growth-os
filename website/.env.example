# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Lead notification (existing adapters)
LEAD_WEBHOOK_URL=
LEAD_CC_EMAILS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# PostgreSQL (required — not SQLite)
DATABASE_URL=postgresql://hfd:hfd_local_dev@127.0.0.1:5432/hfd_growth_os?schema=public
DIRECT_URL=postgresql://hfd:hfd_local_dev@127.0.0.1:5432/hfd_growth_os?schema=public
DATABASE_URL_TEST=postgresql://hfd:hfd_local_dev@127.0.0.1:5432/hfd_growth_os_test?schema=public

# Operations portal isolation (default OFF — public site unaffected)
OPS_ENABLED=false

# Authentication — local credentials ONLY for synthetic / allowlist testing
AUTH_MODE=local_credentials
AUTH_PRODUCTION_APPROVED=false
AUTH_SECRET=change-me-local-dev-secret-min-32-chars!!
SESSION_TTL_HOURS=8

# Automation & safety defaults
AUTOMATION_MODE=draft
OUTBOUND_COMMUNICATIONS_ENABLED=false
OUTBOUND_ALLOWLIST=
OPEN_DENTAL_MODE=mock
OPEN_DENTAL_WRITES_ENABLED=false
OPEN_DENTAL_BASE_URL=
OPEN_DENTAL_DEVELOPER_KEY=
OPEN_DENTAL_CUSTOMER_KEY=
OPEN_DENTAL_CONNECTIONS_JSON=
OPEN_DENTAL_WEBHOOK_TOKEN=
OPEN_DENTAL_REQUEST_TIMEOUT_MS=15000
OPEN_DENTAL_SYNC_ENABLED=false
AI_ENABLED=false
AI_PHI_ALLOWED=false
VOICE_AUTOMATION_ENABLED=false
CALL_RECORDING_ENABLED=false
TREATMENT_PLAN_FOLLOWUP_ENABLED=false
PATIENT_REACTIVATION_ENABLED=false
REVIEW_REQUESTS_ENABLED=false

# Durable worker (separate process — never assume Vercel persistence)
WORKER_EXECUTION_MODE=local
WORKER_ID=local-worker-1
WORKER_LEASE_SECONDS=60
WORKER_POLL_MS=1000
